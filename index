            selectedCellForDrawer = { pillarKey, tierKey };
            const pillarMeta = FLOOR_DESCRIPTORS[pillarKey];
            const tierNum = tierKey === 'TIER1' ? 1 : tierKey === 'TIER2' ? 2 : 3;
            const subList = SUB_COMPETENCIES.filter(s => s.pillar === pillarKey);

            document.getElementById('drawerPillarBadge').innerText = `${pillarKey} PILLAR`;
            document.getElementById('drawerTierBadge').innerText = `TIER ${tierNum}: ${tierKey === 'TIER1' ? 'AWARENESS' : tierKey === 'TIER2' ? 'PROFICIENCY' : 'MASTERY'}`;
            document.getElementById('drawerTitle').innerText = `${pillarMeta.title} (${tierKey === 'TIER1' ? 'Tier 1' : tierKey === 'TIER2' ? 'Tier 2' : 'Tier 3'})`;
            document.getElementById('drawerMacroDescriptor').innerText = `"${pillarMeta[tierKey]}"`;
            document.getElementById('drawerSubCount').innerText = subList.length;

            const subContainer = document.getElementById('drawerSubList');
            subContainer.innerHTML = '';

            subList.forEach(sub => {
                const desc = sub[`tier${tierNum}`];
                const abetCodes = sub[`tier${tierNum}_abet`];
                const casCodes = sub[`tier${tierNum}_cas`];

                const card = document.createElement('div');
                card.className = "bg-slate-50 p-3.5 rounded-lg border border-slate-200 space-y-2";
