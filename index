<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TAMU Citizens for Good (C4G) Operational Taxonomy</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        tamu: {
                            maroon: '#500000',
                            dark: '#3C0000',
                            light: '#6d0000',
                            accent: '#d4af37',
                            slate: '#0f172a'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #94a3b8;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }
        .maroon-gradient {
            background: linear-gradient(135deg, #500000 0%, #3C0000 100%);
        }
    </style>
</head>
<body class="h-full flex flex-col font-sans text-slate-800 bg-slate-100 antialiased">

    <!-- TOP HEADER -->
    <header class="maroon-gradient text-white border-b-4 border-tamu-accent shadow-lg sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div class="flex items-center space-x-3">
                    <div class="bg-white text-tamu-maroon p-2.5 rounded-lg font-black tracking-widest text-xl shadow-md border border-amber-200">
                        TAMU
                    </div>
                    <div>
                        <h1 class="text-xl sm:text-2xl font-bold tracking-tight flex items-center gap-2">
                            Citizenship & Service (C4G)
                            <span class="text-xs bg-amber-400 text-tamu-dark font-extrabold px-2 py-0.5 rounded uppercase tracking-wider">Operational Taxonomy</span>
                        </h1>
                        <p class="text-xs sm:text-sm text-slate-200">Dual-Layer Framework: Floor UI & Bedrock Accreditation Engine</p>
                    </div>
                </div>
                <!-- Action Controls -->
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-xs text-amber-200 font-medium hidden lg:inline">Integrated Framework:</span>
                    <span class="inline-flex items-center gap-1 bg-tamu-dark/80 border border-amber-500/30 text-amber-200 text-xs px-2.5 py-1 rounded-full">
                        <i data-lucide="shield-check" class="w-3.5 h-3.5"></i> ABET (SO 1-7)
                    </span>
                    <span class="inline-flex items-center gap-1 bg-tamu-dark/80 border border-amber-500/30 text-amber-200 text-xs px-2.5 py-1 rounded-full">
                        <i data-lucide="award" class="w-3.5 h-3.5"></i> CAS Domains (1-6)
                    </span>
                </div>
            </div>
        </div>
    </header>

    <!-- NAVIGATION TABS & GLOBAL SEARCH BAR -->
    <div class="bg-white border-b border-slate-200 shadow-sm sticky top-[76px] z-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 py-2">
                
                <!-- Navigation Tabs -->
                <nav class="flex space-x-1 sm:space-x-2 overflow-x-auto pb-1 md:pb-0" id="mainTabs">
                    <button onclick="switchTab('floor')" id="tab-floor" class="tab-btn active inline-flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-semibold transition-all text-tamu-maroon bg-slate-100 border-b-2 border-tamu-maroon">
                        <i data-lucide="layout-grid" class="w-4 h-4"></i> Floor Model (12 UI)
                    </button>
                    <button onclick="switchTab('bedrock')" id="tab-bedrock" class="tab-btn inline-flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-semibold transition-all text-slate-600 hover:text-tamu-maroon hover:bg-slate-50">
                        <i data-lucide="layers" class="w-4 h-4"></i> Bedrock Explorer (63 Cells)
                    </button>
                    <button onclick="switchTab('crosswalk')" id="tab-crosswalk" class="tab-btn inline-flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-semibold transition-all text-slate-600 hover:text-tamu-maroon hover:bg-slate-50">
                        <i data-lucide="filter" class="w-4 h-4"></i> Accreditation Heatmap
                    </button>
                    <button onclick="switchTab('canvas')" id="tab-canvas" class="tab-btn inline-flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-semibold transition-all text-slate-600 hover:text-tamu-maroon hover:bg-slate-50">
                        <i data-lucide="code" class="w-4 h-4"></i> Canvas Tag Generator
                    </button>
                </nav>

                <!-- Search Input -->
                <div class="relative min-w-[240px] max-w-xs">
                    <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="globalSearch" onkeyup="handleSearch()" placeholder="Search competencies, ABET, CAS..." 
                           class="w-full pl-9 pr-3 py-1.5 text-xs sm:text-sm bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-tamu-maroon focus:bg-white transition-all">
                </div>

            </div>
        </div>
    </div>

    <!-- MAIN CONTENT AREA -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- VIEW 1: THE FLOOR MODEL (12 Macro-Cells UI) -->
        <section id="view-floor" class="space-y-6">
            <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-lg shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-start gap-3">
                    <i data-lucide="info" class="w-5 h-5 text-amber-600 shrink-0 mt-0.5"></i>
                    <div>
                        <h3 class="text-sm font-bold text-amber-900">Front-End "Floor Model" Interface</h3>
                        <p class="text-xs text-amber-800">Simplified 12-cell grid designed for low-friction Canvas syllabus tagging and student experience. Click any cell to open the drill-down drawer and inspect inherited Bedrock sub-competencies, ABET outcomes, and CAS domains.</p>
                    </div>
                </div>
                <button onclick="switchTab('canvas')" class="shrink-0 bg-tamu-maroon text-white text-xs font-semibold px-3 py-2 rounded-lg hover:bg-tamu-dark transition-colors shadow flex items-center gap-1.5">
                    <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i> Tag Course in Canvas
                </button>
            </div>

            <!-- 12-CELL MATRIX GRID -->
            <div class="overflow-x-auto pb-4">
                <div class="min-w-[800px] grid grid-cols-4 gap-4">
                    
                    <!-- Grid Header Row -->
                    <div class="col-span-1 bg-tamu-dark text-white p-3 rounded-t-lg font-bold text-xs uppercase tracking-wider flex items-center justify-between">
                        <span>Pillars / Tiers</span>
                    </div>
                    <div class="bg-slate-800 text-white p-3 rounded-t-lg font-bold text-xs uppercase tracking-wider text-center">
                        <span class="text-amber-300">Tier 1:</span> Emerging Awareness
                    </div>
                    <div class="bg-slate-800 text-white p-3 rounded-t-lg font-bold text-xs uppercase tracking-wider text-center">
                        <span class="text-amber-300">Tier 2:</span> Developing Competence
                    </div>
                    <div class="bg-slate-800 text-white p-3 rounded-t-lg font-bold text-xs uppercase tracking-wider text-center">
                        <span class="text-amber-300">Tier 3:</span> Mastery & Leadership
                    </div>

                    <!-- MATRIX ROWS WILL BE GENERATED BY JS -->
                    <div id="floorMatrixGrid" class="col-span-4 grid grid-cols-4 gap-4"></div>

                </div>
            </div>
        </section>

        <!-- VIEW 2: BEDROCK EXPLORER (63 Deep Dive Cells) -->
        <section id="view-bedrock" class="hidden space-y-6">
            <div class="bg-slate-800 text-white p-4 rounded-lg shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h3 class="text-base font-bold text-amber-300 flex items-center gap-2">
                        <i data-lucide="database" class="w-5 h-5"></i> Bedrock Taxonomy Reference Engine
                    </h3>
                    <p class="text-xs text-slate-300 mt-1">Full 21 sub-competencies mapped across 3 progression tiers (63 cells total) with explicit ABET outcomes and CAS domains coded into every coordinate.</p>
                </div>
                <div class="flex items-center gap-2">
                    <select id="bedrockPillarFilter" onchange="filterBedrockView()" class="bg-slate-900 border border-slate-700 text-xs rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:ring-1 focus:ring-amber-400">
                        <option value="ALL">All Core Pillars</option>
                        <option value="KNOWLEDGE">Knowledge Pillar (7 Sub-Themes)</option>
                        <option value="CHARACTER">Character Pillar (3 Sub-Themes)</option>
                        <option value="SKILLS">Skills Pillar (6 Sub-Themes)</option>
                        <option value="SERVICE">Service Pillar (5 Sub-Themes)</option>
                    </select>
                </div>
            </div>

            <!-- BEDROCK CARDS CONTAINER -->
            <div id="bedrockCardsContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
        </section>

        <!-- VIEW 3: ACCREDITATION CROSSWALK HEATMAP -->
        <section id="view-crosswalk" class="hidden space-y-6">
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
                <div class="border-b border-slate-200 pb-4">
                    <h3 class="text-lg font-bold text-tamu-maroon flex items-center gap-2">
                        <i data-lucide="shield-check" class="w-5 h-5"></i> Accreditation Outcome Filter & Heatmap
                    </h3>
                    <p class="text-xs text-slate-600 mt-1">Select an ABET Student Outcome or CAS Domain below to visualize where accreditation standards are satisfied across the C4G matrix.</p>
                </div>

                <!-- FILTER BUTTON GROUPS -->
                <div class="space-y-4">
                    <!-- ABET Group -->
                    <div>
                        <span class="text-xs font-extrabold uppercase tracking-wider text-tamu-maroon block mb-2">ABET Academic Student Outcomes (SO 1 - SO 7):</span>
                        <div class="flex flex-wrap gap-2" id="abetFilterButtons"></div>
                    </div>
                    <!-- CAS Group -->
                    <div>
                        <span class="text-xs font-extrabold uppercase tracking-wider text-slate-700 block mb-2">CAS Co-Curricular Domains (Domain 1 - Domain 6):</span>
                        <div class="flex flex-wrap gap-2" id="casFilterButtons"></div>
                    </div>
                </div>

                <!-- HEATMAP RESULTS SUMMARY -->
                <div id="crosswalkSummary" class="bg-slate-50 border border-slate-200 p-4 rounded-lg flex items-center justify-between">
                    <span class="text-xs sm:text-sm font-medium text-slate-700">Select an outcome tag above to generate compliance coverage report.</span>
                    <button onclick="clearCrosswalkFilter()" class="text-xs text-tamu-maroon font-bold hover:underline hidden" id="btnClearCrosswalk">Reset Heatmap</button>
                </div>

                <!-- HEATMAP MATRIX GRID -->
                <div id="crosswalkGridContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 pt-2"></div>
            </div>
        </section>

        <!-- VIEW 4: CANVAS SYLLABUS & ACTIVITY TAG GENERATOR -->
        <section id="view-canvas" class="hidden space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                
                <!-- INPUT FORM (LEFT) -->
                <div class="lg:col-span-5 bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
                    <div class="border-b border-slate-200 pb-3">
                        <h3 class="text-base font-bold text-tamu-maroon flex items-center gap-2">
                            <i data-lucide="edit-3" class="w-4 h-4"></i> Course & Activity Tagging Wizard
                        </h3>
                        <p class="text-xs text-slate-500">Tag a syllabus or co-curricular activity in 30 seconds to generate ready-to-use Canvas text and backend compliance JSON.</p>
                    </div>

                    <form id="taggerForm" class="space-y-4" onsubmit="event.preventDefault(); generateCanvasPayload();">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Course Code or Activity Title</label>
                            <input type="text" id="tagCourseTitle" placeholder="e.g. ENGR 482 or Aggie Replant Lead" required
                                   class="w-full text-xs sm:text-sm p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-tamu-maroon focus:outline-none">
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Select Core Pillar</label>
                                <select id="tagPillarSelect" onchange="updateTagFormSubOptions()" class="w-full text-xs p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-tamu-maroon focus:outline-none">
                                    <option value="KNOWLEDGE">Knowledge</option>
                                    <option value="CHARACTER">Character</option>
                                    <option value="SKILLS">Skills</option>
                                    <option value="SERVICE">Service</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Select Intensity Tier</label>
                                <select id="tagTierSelect" onchange="generateCanvasPayload()" class="w-full text-xs p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-tamu-maroon focus:outline-none">
                                    <option value="TIER1">Tier 1: Awareness</option>
                                    <option value="TIER2" selected>Tier 2: Proficiency</option>
                                    <option value="TIER3">Tier 3: Mastery</option>
                                </select>
                            </div>
                        </div>

                        <!-- OPTIONAL DRILL-DOWN ACCORDION -->
                        <div class="border border-slate-200 rounded-lg p-3 bg-slate-50">
                            <label class="flex items-center justify-between cursor-pointer" onclick="toggleElement('drilldownChecklist')">
                                <span class="text-xs font-bold text-slate-700 flex items-center gap-1">
                                    <i data-lucide="sliders" class="w-3.5 h-3.5 text-tamu-maroon"></i> Progressive Drill-Down (Optional)
                                </span>
                                <span class="text-[10px] bg-slate-200 text-slate-700 font-bold px-1.5 py-0.5 rounded">Refine Sub-Themes</span>
                            </label>
                            <div id="drilldownChecklist" class="mt-3 space-y-2 max-h-40 overflow-y-auto pt-2 border-t border-slate-200">
                                <!-- JS Populates Sub-Competencies Checkboxes -->
                            </div>
                        </div>

                        <button type="button" onclick="generateCanvasPayload()" class="w-full bg-tamu-maroon text-white font-bold text-xs uppercase tracking-wider py-3 rounded-lg hover:bg-tamu-dark transition-all shadow-md flex items-center justify-center gap-2">
                            <i data-lucide="zap" class="w-4 h-4"></i> Generate Canvas Snippet & Payload
                        </button>
                    </form>
                </div>

                <!-- OUTPUT PANEL (RIGHT) -->
                <div class="lg:col-span-7 space-y-6">
                    
                    <!-- CANVAS SYLLABUS PREVIEW CARD -->
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-200 pb-3">
                            <h4 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                                <i data-lucide="layout" class="w-4 h-4 text-tamu-maroon"></i> Canvas Syllabus / Assignment Snippet
                            </h4>
                            <button onclick="copyToClipboard('canvasSnippetCode', 'btnCopySnippet')" id="btnCopySnippet" class="text-xs bg-slate-100 hover:bg-tamu-maroon hover:text-white border border-slate-300 px-3 py-1.5 rounded-lg transition-all font-semibold flex items-center gap-1">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i> Copy HTML Snippet
                            </button>
                        </div>

                        <!-- VISUAL CANVAS PREVIEW BOX -->
                        <div class="border border-slate-200 rounded-lg overflow-hidden bg-slate-50">
                            <div class="bg-tamu-maroon text-white px-4 py-2 text-xs font-bold flex items-center justify-between">
                                <span>Texas A&M C4G Course Framework</span>
                                <span class="text-[10px] bg-amber-400 text-tamu-dark px-1.5 py-0.5 rounded font-extrabold uppercase" id="previewBadgeTier">TIER 2</span>
                            </div>
                            <div class="p-4 space-y-3 bg-white" id="canvasVisualPreview">
                                <!-- Populated dynamically by JS -->
                            </div>
                        </div>

                        <!-- RAW HTML SNIPPET -->
                        <details class="text-xs">
                            <summary class="cursor-pointer font-semibold text-slate-600 hover:text-tamu-maroon py-1">View Raw HTML Code for Canvas Editor</summary>
                            <pre id="canvasSnippetCode" class="mt-2 p-3 bg-slate-900 text-slate-200 rounded-lg text-[11px] font-mono overflow-x-auto whitespace-pre-wrap border border-slate-800"></pre>
                        </details>
                    </div>

                    <!-- BACKEND JSON PAYLOAD CARD -->
                    <div class="bg-slate-900 text-slate-100 p-6 rounded-xl shadow-md space-y-4 border border-slate-800">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                            <div>
                                <h4 class="text-sm font-bold text-amber-300 flex items-center gap-2">
                                    <i data-lucide="terminal" class="w-4 h-4"></i> Backend Accreditation Compliance Payload
                                </h4>
                                <p class="text-[11px] text-slate-400">Auto-inherited ABET Outcomes and CAS Domains ready for Provost / SACSCOC reporting database.</p>
                            </div>
                            <button onclick="copyToClipboard('jsonPayloadCode', 'btnCopyJson')" id="btnCopyJson" class="text-xs bg-slate-800 hover:bg-amber-400 hover:text-tamu-dark border border-slate-700 px-3 py-1.5 rounded-lg transition-all font-semibold text-amber-300 flex items-center gap-1">
                                <i data-lucide="copy" class="w-3.5 h-3.5"></i> Copy JSON Payload
                            </button>
                        </div>
                        <pre id="jsonPayloadCode" class="p-3 bg-slate-950 text-emerald-400 rounded-lg text-xs font-mono overflow-x-auto whitespace-pre-wrap border border-slate-800 max-h-56"></pre>
                    </div>

                </div>

            </div>
        </section>

    </main>

    <!-- DRILL-DOWN MODAL / DRAWER FOR FLOOR MODEL CELL -->
    <div id="cellDrawerModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex justify-end transition-opacity">
        <div class="bg-white w-full max-w-2xl h-full shadow-2xl flex flex-col justify-between overflow-hidden transform transition-transform duration-300">
            
            <!-- Drawer Header -->
            <div class="p-5 border-b border-slate-200 bg-slate-900 text-white flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <span id="drawerPillarBadge" class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-tamu-maroon text-white">PILLAR</span>
                        <span id="drawerTierBadge" class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-amber-400 text-tamu-dark">TIER</span>
                    </div>
                    <h3 id="drawerTitle" class="text-lg font-bold text-amber-200 mt-1">Cell Title</h3>
                </div>
                <button onclick="closeDrawer()" class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition-colors">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>

            <!-- Drawer Body -->
            <div class="p-6 overflow-y-auto space-y-6 flex-1">
                
                <!-- Macro Summary -->
                <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-lg">
                    <h4 class="text-xs font-bold text-amber-900 uppercase tracking-wider mb-1">Macro Floor Descriptor</h4>
                    <p id="drawerMacroDescriptor" class="text-sm font-medium text-amber-900 leading-relaxed"></p>
                </div>

                <!-- Bedrock Sub-Competencies Accordion List -->
                <div>
                    <h4 class="text-xs font-extrabold uppercase tracking-wider text-slate-700 mb-3 flex items-center justify-between">
                        <span>Inherited Bedrock Sub-Competencies (<span id="drawerSubCount">0</span>)</span>
                        <span class="text-[11px] font-normal text-slate-500">Fully Mapped Accreditation Codes</span>
                    </h4>
                    <div id="drawerSubList" class="space-y-3"></div>
                </div>

            </div>

            <!-- Drawer Footer -->
            <div class="p-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between">
                <button onclick="closeDrawer()" class="px-4 py-2 border border-slate-300 text-xs font-bold text-slate-700 rounded-lg hover:bg-slate-200 transition-colors">
                    Close Inspector
                </button>
                <button id="btnDrawerUseTag" onclick="useCellInCanvasTagger()" class="px-4 py-2 bg-tamu-maroon text-white text-xs font-bold rounded-lg hover:bg-tamu-dark transition-colors flex items-center gap-1.5 shadow">
                    <i data-lucide="check-circle" class="w-4 h-4"></i> Tag This Cell in Canvas
                </button>
            </div>

        </div>
    </div>

    <!-- JAVASCRIPT LOGIC & TAXONOMY DATA -->
    <script>
        // --- 1. ACCREDITATION TAXONOMY DATA DICTIONARIES ---
        const ABET_OUTCOMES = {
            SO1: { code: "SO 1", name: "Complex Problem Solving", text: "ABET SO 1: Identify, formulate, and solve complex engineering/technical problems by applying principles of engineering, science, and mathematics." },
            SO2: { code: "SO 2", name: "Contextual Solution Design", text: "ABET SO 2: Apply engineering design to produce solutions that meet specified needs with consideration of public health, safety, and welfare, as well as global, cultural, social, environmental, and economic factors." },
            SO3: { code: "SO 3", name: "Effective Communication", text: "ABET SO 3: Communicate effectively with a range of audiences across diverse professional and community settings." },
            SO4: { code: "SO 4", name: "Ethical & Professional Responsibility", text: "ABET SO 4: Recognize ethical and professional responsibilities in engineering situations and make informed judgments, which must consider the impact of engineering solutions in global, economic, environmental, and societal contexts." },
            SO5: { code: "SO 5", name: "Team Leadership & Collaboration", text: "ABET SO 5: Function effectively on a team whose members together provide leadership, create a collaborative and inclusive environment, establish goals, plan tasks, and meet objectives." },
            SO6: { code: "SO 6", name: "Data Analysis & Experimentation", text: "ABET SO 6: Develop and conduct appropriate experimentation, analyze and interpret data, and use engineering judgment to draw conclusions." },
            SO7: { code: "SO 7", name: "Continuous Knowledge Acquisition", text: "ABET SO 7: Acquire and apply new knowledge as needed, using appropriate learning strategies." }
        };

        const CAS_DOMAINS = {
            CAS1: { code: "Domain 1", name: "Knowledge Acquisition & Application", text: "CAS Domain 1: Knowledge acquisition, construction, integration and application." },
            CAS2: { code: "Domain 2", name: "Cognitive Complexity", text: "CAS Domain 2: Cognitive complexity, critical thinking, and reflective judgment." },
            CAS3: { code: "Domain 3", name: "Intrapersonal Development", text: "CAS Domain 3: Intrapersonal development (identity, ethics, self-efficacy, stewardship)." },
            CAS4: { code: "Domain 4", name: "Interpersonal Competence", text: "CAS Domain 4: Interpersonal competence, dialogue, and meaningful relationships." },
            CAS5: { code: "Domain 5", name: "Humanitarianism & Civic Engagement", text: "CAS Domain 5: Humanitarianism, civic engagement, social responsibility, and community partnership." },
            CAS6: { code: "Domain 6", name: "Practical Competence", text: "CAS Domain 6: Practical competence, leadership execution, communication, and operational effectiveness." }
        };

        // --- 2. C4G 21 SUB-COMPETENCIES DATA (BEDROCK LAYER) ---
        const SUB_COMPETENCIES = [
            // KNOWLEDGE PILLAR (7)
            {
                id: "1.1", pillar: "KNOWLEDGE", title: "Purpose of Institutions",
