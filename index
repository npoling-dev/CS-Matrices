        // --- RENDER ACCREDITATION CROSSWALK HEATMAP (VIEW 3) ---
        function renderCrosswalkButtons() {
            const abetContainer = document.getElementById('abetFilterButtons');
            const casContainer = document.getElementById('casFilterButtons');

            abetContainer.innerHTML = Object.keys(ABET_OUTCOMES).map(key => `
                <button onclick="setCrosswalkFilter('${key}', 'ABET')" id="btnFilter-${key}" 
                        class="text-xs font-bold px-3 py-1.5 rounded-lg border border-tamu-maroon text-tamu-maroon hover:bg-tamu-maroon hover:text-white transition-all">
                    ${ABET_OUTCOMES[key].code}: ${ABET_OUTCOMES[key].name}
                </button>
            `).join('');

            casContainer.innerHTML = Object.keys(CAS_DOMAINS).map(key => `
                <button onclick="setCrosswalkFilter('${key}', 'CAS')" id="btnFilter-${key}" 
                        class="text-xs font-bold px-3 py-1.5 rounded-lg border border-slate-600 text-slate-700 hover:bg-slate-800 hover:text-white transition-all">
                    ${CAS_DOMAINS[key].code}: ${CAS_DOMAINS[key].name}
                </button>
            `).join('');
        }

        function setCrosswalkFilter(codeKey, type) {
            activeCrosswalkFilter = { codeKey, type };
            
            // Highlight active button
            document.querySelectorAll('#abetFilterButtons button, #casFilterButtons button').forEach(btn => {
                btn.classList.remove('bg-tamu-maroon', 'bg-slate-800', 'text-white');
            });
            const activeBtn = document.getElementById(`btnFilter-${codeKey}`);
            if (activeBtn) {
                activeBtn.classList.add(type === 'ABET' ? 'bg-tamu-maroon' : 'bg-slate-800', 'text-white');
            }

            document.getElementById('btnClearCrosswalk').classList.remove('hidden');
            renderCrosswalkGrid();
        }

        function clearCrosswalkFilter() {
            activeCrosswalkFilter = null;
            document.querySelectorAll('#abetFilterButtons button, #casFilterButtons button').forEach(btn => {
                btn.classList.remove('bg-tamu-maroon', 'bg-slate-800', 'text-white');
            });
            document.getElementById('btnClearCrosswalk').classList.add('hidden');
            document.getElementById('crosswalkSummary').innerHTML = `<span class="text-xs sm:text-sm font-medium text-slate-700">Select an outcome tag above to generate compliance coverage report.</span>`;
            renderCrosswalkGrid();
        }

        function renderCrosswalkGrid() {
            const container = document.getElementById('crosswalkGridContainer');
            container.innerHTML = '';

            if (!activeCrosswalkFilter) {
                container.innerHTML = `
                    <div class="col-span-3 text-center py-12 text-slate-400 bg-slate-50 rounded-xl border border-dashed border-slate-300">
                        <i data-lucide="filter" class="w-8 h-8 mx-auto mb-2 opacity-50"></i>
                        <p class="text-xs font-semibold">Click any ABET Outcome (SO 1-7) or CAS Domain (1-6) above to highlight matching cells.</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            const { codeKey, type } = activeCrosswalkFilter;
            const fullMeta = type === 'ABET' ? ABET_OUTCOMES[codeKey] : CAS_DOMAINS[codeKey];

            let totalMatches = 0;

            SUB_COMPETENCIES.forEach(sub => {
                const t1Match = sub[type === 'ABET' ? 'tier1_abet' : 'tier1_cas'].includes(codeKey);
                const t2Match = sub[type === 'ABET' ? 'tier2_abet' : 'tier2_cas'].includes(codeKey);
                const t3Match = sub[type === 'ABET' ? 'tier3_abet' : 'tier3_cas'].includes(codeKey);

                if (t1Match || t2Match || t3Match) {
                    totalMatches++;
                    const card = document.createElement('div');
                    card.className = "bg-white p-4 rounded-xl border-2 border-amber-400 shadow-sm space-y-2";
                    card.innerHTML = `
                        <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                            <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-tamu-maroon text-white">${sub.pillar}</span>
                            <span class="text-xs font-bold text-tamu-maroon">${sub.id} ${sub.title}</span>
                        </div>
                        <div class="space-y-1 text-xs pt-1">
                            ${t1Match ? `<div class="bg-amber-50 p-1.5 rounded border-l-2 border-amber-500"><strong class="text-amber-800">Tier 1:</strong> ${sub.tier1}</div>` : ''}
                            ${t2Match ? `<div class="bg-amber-50 p-1.5 rounded border-l-2 border-amber-500"><strong class="text-amber-800">Tier 2:</strong> ${sub.tier2}</div>` : ''}
                            ${t3Match ? `<div class="bg-amber-50 p-1.5 rounded border-l-2 border-amber-500"><strong class="text-amber-800">Tier 3:</strong> ${sub.tier3}</div>` : ''}
                        </div>
                    `;
                    container.appendChild(card);
                }
            });

            document.getElementById('crosswalkSummary').innerHTML = `
                <div>
                    <span class="text-xs font-extrabold uppercase tracking-wider text-tamu-maroon block">Active Accreditation Filter: ${fullMeta.code} (${fullMeta.name})</span>
                    <p class="text-xs text-slate-600 mt-0.5">${fullMeta.text}</p>
                </div>
                <div class="text-right">
                    <span class="text-lg font-black text-tamu-maroon">${totalMatches}</span>
                    <span class="text-xs text-slate-500 block">Matching Cells</span>
                </div>
            `;
        }

        // --- 5. CANVAS TAG GENERATOR LOGIC (VIEW 4) ---
        function updateTagFormSubOptions() {
            const pillar = document.getElementById('tagPillarSelect').value;
            const container = document.getElementById('drilldownChecklist');
            const subs = SUB_COMPETENCIES.filter(s => s.pillar === pillar);

            container.innerHTML = subs.map(s => `
                <label class="flex items-center gap-2 text-xs text-slate-700 cursor-pointer hover:text-tamu-maroon">
                    <input type="checkbox" value="${s.id}" class="sub-checkbox rounded text-tamu-maroon focus:ring-tamu-maroon" onchange="generateCanvasPayload()">
                    <span>${s.id} ${s.title}</span>
                </label>
            `).join('');
            generateCanvasPayload();
        }

        function generateCanvasPayload() {
            const courseTitle = document.getElementById('tagCourseTitle').value || 'ENGR 482 / Aggie Replant Lead';
            const pillar = document.getElementById('tagPillarSelect').value;
            const tier = document.getElementById('tagTierSelect').value;
            const pillarMeta = FLOOR_DESCRIPTORS[pillar];
            const tierNum = tier === 'TIER1' ? 1 : tier === 'TIER2' ? 2 : 3;

            // Get selected sub-competencies or fallback to all sub-competencies for that pillar
            const checkedBoxes = Array.from(document.querySelectorAll('.sub-checkbox:checked')).map(cb => cb.value);
            const activeSubs = checkedBoxes.length > 0 
                ? SUB_COMPETENCIES.filter(s => checkedBoxes.includes(s.id))
                : SUB_COMPETENCIES.filter(s => s.pillar === pillar);

            // Inherit ABET and CAS codes
            let abetCodes = new Set();
            let casCodes = new Set();
            activeSubs.forEach(s => {
                s[`tier${tierNum}_abet`].forEach(a => abetCodes.add(a));
                s[`tier${tierNum}_cas`].forEach(c => casCodes.add(c));
            });

            // Update Tier Badge Preview
            document.getElementById('previewBadgeTier').innerText = `TIER ${tierNum}: ${tier === 'TIER1' ? 'AWARENESS' : tier === 'TIER2' ? 'PROFICIENCY' : 'MASTERY'}`;

            // Visual Canvas HTML
            const visualContainer = document.getElementById('canvasVisualPreview');
            visualContainer.innerHTML = `
                <div class="space-y-2">
                    <h4 class="text-sm font-bold text-tamu-maroon">${courseTitle}</h4>
                    <p class="text-xs font-semibold text-slate-800">C4G Pillar Focus: ${pillarMeta.title} (${pillarMeta.subtitle})</p>
                    <p class="text-xs text-slate-600 italic bg-slate-50 p-2.5 rounded border border-slate-200">
                        "${pillarMeta[tier]}"
                    </p>
                    <div class="pt-2 flex flex-wrap gap-1.5">
                        ${Array.from(abetCodes).map(code => `<span class="bg-tamu-maroon text-white text-[10px] font-bold px-2 py-0.5 rounded">${ABET_OUTCOMES[code].code}: ${ABET_OUTCOMES[code].name}</span>`).join('')}
                        ${Array.from(casCodes).map(code => `<span class="bg-slate-700 text-amber-200 text-[10px] font-bold px-2 py-0.5 rounded">${CAS_DOMAINS[code].code}: ${CAS_DOMAINS[code].name}</span>`).join('')}
                    </div>
                </div>
            `;

            // Raw Snippet Code
            const rawSnippet = `<div style="border: 2px solid #500000; border-radius: 8px; padding: 16px; background-color: #ffffff; font-family: 'Inter', sans-serif;">
  <div style="background-color: #500000; color: #ffffff; padding: 6px 12px; font-weight: bold; font-size: 12px; border-radius: 4px 4px 0 0;">
    TEXAS A&M C4G CITIZENSHIP FRAMEWORK
  </div>
  <div style="padding: 12px 0;">
    <h4 style="margin: 0 0 8px 0; color: #500000; font-size: 14px;">Course Civic Objective (${pillarMeta.title})</h4>
    <p style="font-size: 12px; color: #334155; margin: 0 0 8px 0; font-style: italic;">
      "${pillarMeta[tier]}"
    </p>
  </div>
</div>`;
            document.getElementById('canvasSnippetCode').innerText = rawSnippet;

            // Compliance JSON Payload
            const jsonPayload = {
                institution: "Texas A&M University",
                program: "Citizenship & Service (C4G)",
                course_activity: courseTitle,
                matrix_coordinate: {
                    pillar: pillar,
                    tier: `TIER_${tierNum}`,
                    macro_descriptor: pillarMeta[tier]
                },
                selected_sub_competencies: activeSubs.map(s => ({ id: s.id, title: s.title })),
                accreditation_inheritance: {
                    abet_student_outcomes: Array.from(abetCodes).map(c => ({ code: ABET_OUTCOMES[c].code, title: ABET_OUTCOMES[c].name })),
                    cas_domains: Array.from(casCodes).map(c => ({ code: CAS_DOMAINS[c].code, title: CAS_DOMAINS[c].name }))
                },
                timestamp: new Date().toISOString()
            };
            document.getElementById('jsonPayloadCode').innerText = JSON.stringify(jsonPayload, null, 2);
        }

        // --- UTILITY FUNCTIONS ---
        function toggleElement(id) {
            document.getElementById(id).classList.toggle('hidden');
        }

        function copyToClipboard(elementId, btnId) {
            const text = document.getElementById(elementId).innerText;
            
            // Fallback copy execution for sandboxed contexts
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            document.body.appendChild(textarea);
            textarea.select();
            
            try {
                document.execCommand('copy');
                const btn = document.getElementById(btnId);
                const originalHtml = btn.innerHTML;
                btn.innerHTML = `<i data-lucide="check" class="w-3.5 h-3.5 text-emerald-500"></i> Copied!`;
                btn.classList.add('bg-emerald-50', 'border-emerald-500', 'text-emerald-700');
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.classList.remove('bg-emerald-50', 'border-emerald-500', 'text-emerald-700');
                    lucide.createIcons();
                }, 2000);
            } catch (err) {
                console.error('Copy failed', err);
            } finally {
                document.body.removeChild(textarea);
            }
        }

        function handleSearch() {
            const query = document.getElementById('globalSearch').value.toLowerCase();
            if (!query) return;

            // Auto-switch to Bedrock and filter
            switchTab('bedrock');
            const cards = document.querySelectorAll('#bedrockCardsContainer > div');
            cards.forEach(card => {
                const text = card.innerText.toLowerCase();
                card.style.display = text.includes(query) ? 'flex' : 'none';
            });
        }
    </script>
</body>
