        // Tab Switching
        function switchTab(tabName) {
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active', 'text-tamu-maroon', 'bg-slate-100', 'border-b-2', 'border-tamu-maroon');
                btn.classList.add('text-slate-600');
            });
            const activeBtn = document.getElementById(`tab-${tabName}`);
            activeBtn.classList.add('active', 'text-tamu-maroon', 'bg-slate-100', 'border-b-2', 'border-tamu-maroon');

            ['floor', 'bedrock', 'crosswalk', 'canvas'].forEach(view => {
                document.getElementById(`view-${view}`).classList.add('hidden');
            });
            document.getElementById(`view-${tabName}`).classList.remove('hidden');
            lucide.createIcons();
        }

